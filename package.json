{
	"name": "xoxo",
	"version": "0.1.2",
	"description": "loudspeaker crossover modeller",
	"main": "dist/main/index.js",
	"scripts": {
		"predev": "node -e \"const fs=require('fs'),p=require('path');fs.mkdirSync(p.join('dist','main'),{recursive:true});fs.readdirSync(p.join('src','main')).filter(f=>f.endsWith('.js')&&f!=='index.js').forEach(f=>fs.copyFileSync(p.join('src','main',f),p.join('dist','main',f)))\"",
		"prebuild": "node -e \"const fs=require('fs'),p=require('path');fs.mkdirSync(p.join('dist','main'),{recursive:true});fs.readdirSync(p.join('src','main')).filter(f=>f.endsWith('.js')&&f!=='index.js').forEach(f=>fs.copyFileSync(p.join('src','main',f),p.join('dist','main',f)))\"",
		"dev": "cross-env NODE_ENV=development vite",
		"build": "cross-env NODE_ENV=production vite build",
		"build:win": "npm run build && electron-builder --win",
		"build:mac": "npm run build && electron-builder --mac",
		"build:linux": "npm run build && electron-builder --linux",
		"preview": "vite preview",
		"lint": "eslint --ext .js,.vue src",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage",
		"release": "./scripts/release.sh"
	},
	"keywords": [],
	"author": "Adam Lockhart <adamlockhart12@gmail.com>",
	"license": "MIT",
	"dependencies": {
		"ajv": "^8.17.1",
		"complex.js": "^2.4.3",
		"mathjs": "^15.1.1",
		"socket.io-client": "^4.7.5",
		"vue": "^3.3.4",
		"vue-toastification": "^2.0.0-rc.5",
		"vuex": "^4.1.0"
	},
	"devDependencies": {
		"@babel/eslint-parser": "^7.22.15",
		"@babel/preset-env": "^7.29.7",
		"@babel/register": "^7.28.6",
		"@vitejs/plugin-vue": "^6.0.4",
		"@vue/test-utils": "^2.4.6",
		"@vue/vue3-jest": "^29.2.6",
		"ajv-formats": "^3.0.1",
		"babel-jest": "^29.7.0",
		"babel-plugin-module-resolver": "^5.0.3",
		"cross-env": "^10.1.0",
		"electron": "^26.2.1",
		"electron-builder": "^26.7.0",
		"eslint": "^7.2.0",
		"eslint-config-airbnb-base": "14.2.1",
		"eslint-import-resolver-alias": "^1.1.2",
		"eslint-plugin-import": "^2.22.1",
		"eslint-plugin-vue": "^7.0.0-beta.4",
		"fast-check": "^4.5.3",
		"jest": "^29.7.0",
		"jest-environment-jsdom": "^29.7.0",
		"vite": "^7.3.1",
		"vite-plugin-electron": "^0.29.0",
		"vite-plugin-electron-renderer": "^0.14.6",
		"vue-eslint-parser": "^7.9.0"
	},
	"engines": {
		"node": ">=18.0.0"
	},
	"build": {
		"appId": "com.xoxo.crossover-simulator",
		"productName": "xoxo",
		"directories": {
			"output": "release",
			"buildResources": "assets"
		},
		"files": [
			"dist/**/*",
			"src/data/**/*",
			"package.json"
		],
		"mac": {
			"category": "public.app-category.utilities",
			"target": [
				{
					"target": "dmg",
					"arch": [
						"x64",
						"arm64"
					]
				},
				{
					"target": "zip",
					"arch": [
						"x64",
						"arm64"
					]
				}
			]
		},
		"win": {
			"target": [
				"nsis",
				"portable"
			]
		},
		"linux": {
			"target": [
				"AppImage",
				"deb"
			],
			"category": "Audio"
		}
	}
}
