{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "impedance-response-data.schema.json",
	"title": "Impedance Response Data",
	"description": "Output from ImpedanceCalculator.calculateInputImpedance() method",
	"type": "object",
	"required": ["frequencies", "impedances", "phases"],
	"properties": {
		"frequencies": {
			"type": "array",
			"items": {
				"type": "number",
				"exclusiveMinimum": 0
			},
			"minItems": 1,
			"description": "Frequency points in Hz"
		},
		"impedances": {
			"type": "array",
			"items": {
				"type": "number",
				"minimum": 0
			},
			"description": "Impedance magnitude values in ohms (may include Infinity for open circuit)"
		},
		"phases": {
			"type": "array",
			"items": {
				"type": "number",
				"minimum": -180,
				"maximum": 180
			},
			"description": "Impedance phase values in degrees"
		}
	}
}
